<Window
    x:Class="SplitOS.GameLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SplitOS Game Launcher">
    <Grid Padding="48" Loaded="OnLoaded">
        <StackPanel Spacing="16">
            <TextBlock Text="SplitOS" FontSize="44" FontWeight="SemiBold" />
            <TextBlock Text="Game Launcher · SLICE-00 shell" FontSize="20" Opacity="0.7" />
            <TextBlock x:Name="StatusText" Text="Connecting to Runtime Host…" FontSize="18" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
