<Window
    x:Class="SplitOS.Manager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SplitOS Manager">
    <Grid Padding="32" Loaded="OnLoaded">
        <StackPanel Spacing="12">
            <TextBlock Text="SplitOS Manager" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="SLICE-02 Account / Entitlement Runtime" Opacity="0.7" />
            <TextBlock x:Name="StatusText" Text="Connecting to Runtime Host…" TextWrapping="Wrap" />
            <TextBlock x:Name="StateText" Text="Reading canonical state…" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="SignInButton"
                    Content="Sign in to SplitOS"
                    Visibility="Collapsed"
                    Click="OnSignInClick" />
                <Button
                    x:Name="SignOutButton"
                    Content="Sign out"
                    Visibility="Collapsed"
                    Click="OnSignOutClick" />
            </StackPanel>
            <TextBlock x:Name="AuthText" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>
    </Grid>
</Window>
